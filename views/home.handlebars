<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-lg p-4 p-md-5 border-0">
            <div class="text-center mb-4">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="fa-solid fa-book-medical fs-3"></i>
                </div>
                <h1 class="fw-bold h3">Cadastrar Novo Livro</h1>
                <p class="text-muted">Preencha os campos abaixo para adicionar um livro ao banco de dados relacional.</p>
            </div>
            
            <form class="row g-3" action="/livros/cadastrar" method="post">
                <div class="col-md-6">
                    <label for="titulo" class="form-label text-uppercase text-secondary small fw-bold">Título do Livro</label>
                    <input class="form-control" type="text" name="titulo" id="titulo" placeholder="Ex: Clean Code" required>
                </div>
                <div class="col-md-6">
                    <label for="author" class="form-label text-uppercase text-secondary small fw-bold">Autor</label>
                    <input class="form-control" type="text" name="author" id="author" placeholder="Ex: Robert C. Martin" required>
                </div> 
                <div class="col-md-12">
                    <label for="paginas" class="form-label text-uppercase text-secondary small fw-bold">Número de Páginas</label>
                    <input class="form-control" type="number" name="paginas" id="paginas" placeholder="Ex: 464" required>
                </div> 
                <div class="col-12">
                    <label for="descricao" class="form-label text-uppercase text-secondary small fw-bold">Descrição</label>
                    <textarea class="form-control" name="descricao" id="descricao" rows="4" placeholder="Breve sinopse do livro..." required></textarea>
                </div>
                <div class="col-12 mt-4 text-center">
                    <button type="submit" class="btn btn-primary px-5 py-3 w-100 shadow-sm">
                        <i class="fa-solid fa-plus-circle me-2"></i> Salvar Livro no Banco
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>